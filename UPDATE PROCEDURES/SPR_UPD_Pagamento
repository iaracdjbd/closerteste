CREATE PROCEDURE SPR_UPD_Pagamento (
    @id_pagamento INT,
    @id_mensalidade INT,
    @data_pagamento DATE,
    @valor_pago DECIMAL(10,2)
) AS
BEGIN
    UPDATE pagamentos SET id_mensalidade = @id_mensalidade, data_pagamento = @data_pagamento, valor_pago = @valor_pago WHERE id_pagamento = @id_pagamento;
END;
